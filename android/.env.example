# ─── SIMBA Android environment configuration (V21 P02 T02.01) ──────────
# Copy this file to `android/.env` and fill in real values.
# `android/.env` is gitignored — never commit real keys.
#
# Each key is consumed by `react-native-config` (via
# `dotenv.gradle`, applied in `android/app/build.gradle`) and
# exposed to JS as `Config.PODCAST_INDEX_API_KEY` etc. (see
# `src/constants/env.ts`).
#
# If a key is missing, the build fails fast with a clear error
# pointing to this file (T02.02). Empty strings are accepted for
# "not used" — adapters that read them will see '' and skip the
# call, but a missing line will fail the build.

# Podcast Index (https://api.podcastindex.org/) — used by
# `src/services/api/podcastIndexAdapter.ts` for podcast search,
# episode lookup, and category catalog. D-022 will move this
# adapter to `src/infrastructure/api/podcastindex/`.
PODCAST_INDEX_API_KEY=
PODCAST_INDEX_API_SECRET=

# Jamendo (https://developer.jamendo.com/v3.0) — used by
# `src/services/api/jamendoAdapter.ts` for music search and
# trending tracks. D-022 will move to `src/infrastructure/api/jamendo/`.
JAMENDO_CLIENT_ID=
JAMENDO_CLIENT_SECRET=

# Audius (https://audius.co/api) — used by
# `src/services/api/audiusAdapter.ts` for music search. D-022
# will move to `src/infrastructure/api/audius/`.
AUDIUS_API_KEY=

# Google Web Client ID — used by `src/services/authService.ts`
# for OAuth sign-in. Optional; the app falls back to a guest
# session when empty.
GOOGLE_WEB_CLIENT_ID=
