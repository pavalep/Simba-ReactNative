<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- P61: weather greeting on Home. Foreground location only — we
         ask at runtime via PermissionsAndroid inside the hook, never
         in the background. Coarse is the primary; fine is the
         upgrade when the user grants "precise". -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Required for foreground media playback notification (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required for foreground service media type (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- T19.03 + local media scan: read user audio files. Legacy permission
         for Android ≤12; READ_MEDIA_AUDIO replaces it on Android 13+. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
                     android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">

      <!-- ── Native animated splash (LAUNCHER) ── -->
      <!--
        v11 T8.2: removed `android:screenOrientation="portrait"`.
        The JS layer (MpvBridgeModule.setOrientation) is the sole
        authority for orientation. The splash is short-lived (2-3
        seconds) so a brief sensor-driven orientation on cold
        launch is acceptable; MainActivity.onCreate re-pins to
        portrait once RN takes over.
      -->
      <activity
        android:name=".SplashActivity"
        android:theme="@style/SplashTheme"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- ── Main React Native activity ── -->
      <!--
        v11 T8.2: removed `android:screenOrientation="portrait"`.
        Orientation is now driven by:
          - MainActivity.onCreate: pins to USER_PORTRAIT (the
            app visually stays portrait outside the player).
          - MpvBridgeModule.setOrientation (T8.1): the player
            toggles to USER_LANDSCAPE on fullscreen, restores
            to USER_PORTRAIT on close.
          - MainActivity.onResume: re-pins to USER_PORTRAIT so
            resume-from-background always lands in portrait
            unless the player is mid-fullscreen and re-applies
            via JS.
        The orientation contract is now: app = portrait, player
        = either (per the chip), the JS layer is the only thing
        that can flip it during a session.

        2026-11-12 (CF-01): `launchMode` is `singleTask`, not
        `singleTop`.

        A deep link is delivered to the activity that already exists,
        through `onNewIntent` — and React Native's `ReactActivity`
        forwards that to the JS linking layer itself
        (`ReactActivity.java:133-137` -> `mDelegate.onNewIntent`),
        so no Kotlin change was needed. What was missing was the
        MANIFEST side, and that is what this edit adds.

        `singleTop` only reuses an activity that is already at the
        top of the TARGET task. A `simbaplayer://` link is opened
        from a browser or another app, so the target task is not the
        app's own and the system was free to start a SECOND
        MainActivity in a new task — the app would open twice, and
        the deep link would land in the copy the user was not
        looking at. `singleTask` makes MainActivity the single
        instance of its task and routes every launch at it, which is
        what a deep link needs. It is also the value React
        Navigation's own documentation recommends for deep links.
      -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:resizeableActivity="true"
        android:supportsPictureInPicture="true"
        android:exported="true">
        <!-- Deep links: simbaplayer://artist/Eminem, simbaplayer://library/... etc.
             The route table lives in src/navigation/linking.ts; this filter
             only tells Android to DELIVER the intent to this app.
             Without it the app is never even asked, and every
             simbaplayer:// link is dead. The `simbaplayer.app` WEB
             prefix was removed on 2026-11-12 — the project has no
             website, and claiming a domain it does not own would
             hijack it from whoever does. -->
        <intent-filter>
          <action android:name="android.intent.action.VIEW" />
          <category android:name="android.intent.category.DEFAULT" />
          <category android:name="android.intent.category.BROWSABLE" />
          <data android:scheme="simbaplayer" />
        </intent-filter>
        <!-- Accept shared video/audio files from other apps -->
        <intent-filter>
          <action android:name="android.intent.action.VIEW" />
          <category android:name="android.intent.category.DEFAULT" />
          <data android:mimeType="video/*" />
          <data android:mimeType="audio/*" />
        </intent-filter>
        <!-- Handle content:// URIs from file managers -->
        <intent-filter>
          <action android:name="android.intent.action.VIEW" />
          <category android:name="android.intent.category.DEFAULT" />
          <data android:scheme="content" android:mimeType="video/*" />
          <data android:scheme="content" android:mimeType="audio/*" />
        </intent-filter>
      </activity>

      <!-- ── Foreground media notification service ── -->
      <!--
        V12 retirement: the consumer-app MediaNotificationService.kt
        (387 lines) was removed in W4 P15. The library module's
        MediaPlaybackService is now the sole foreground-notification
        owner — it's registered in the library's own AndroidManifest.xml
        and merged into the final APK at build time.
      -->
    </application>
</manifest>
