<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- P61: weather greeting on Home. Foreground location only — we
         ask at runtime via PermissionsAndroid inside the hook, never
         in the background. Coarse is the primary; fine is the
         upgrade when the user grants "precise". -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Required for foreground media playback notification (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Required for foreground service media type (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true">

      <!-- ── Native animated splash (LAUNCHER) ── -->
      <activity
        android:name=".SplashActivity"
        android:theme="@style/SplashTheme"
        android:screenOrientation="portrait"
        android:exported="true">
        <intent-filter>
          <action android:name="android.intent.action.MAIN" />
          <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!-- ── Main React Native activity ── -->
      <!--
        V6 2.3.2: Locked to portrait at the OS level. The player screen
        lets the user rotate to landscape via the rotate button in
        VideoPlayerTopBar, which calls handleToggleRotate →
        lockToLandscape()/lockToPortrait() from utils/orientation.ts.
        That call uses react-native-orientation-locker, which calls
        Activity.setRequestedOrientation(...) to override this manifest
        at runtime. When the player unmounts, the cleanup effect
        restores portrait (lockToPortrait()).
        Do NOT change this to "fullSensor" or "unspecified" — the
        nav option `orientation: 'landscape'` was removed from
        RootNavigator.tsx (VideoPlayer screen) so the player now
        defaults to portrait and only flips when the user asks.
      -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:screenOrientation="portrait"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTop"
        android:windowSoftInputMode="adjustResize"
        android:supportsPictureInPicture="true"
        android:exported="true">
        <!-- Accept shared video/audio files from other apps -->
        <intent-filter>
          <action android:name="android.intent.action.VIEW" />
          <category android:name="android.intent.category.DEFAULT" />
          <data android:mimeType="video/*" />
          <data android:mimeType="audio/*" />
        </intent-filter>
        <!-- Handle content:// URIs from file managers -->
        <intent-filter>
          <action android:name="android.intent.action.VIEW" />
          <category android:name="android.intent.category.DEFAULT" />
          <data android:scheme="content" android:mimeType="video/*" />
          <data android:scheme="content" android:mimeType="audio/*" />
        </intent-filter>
      </activity>

      <!-- ── Foreground media notification service ── -->
      <service
        android:name=".MediaNotificationService"
        android:foregroundServiceType="mediaPlayback"
        android:exported="false">
        <intent-filter>
          <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent-filter>
      </service>
    </application>
</manifest>
