<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night mode. The native splash follows the PHONE's setting, the
         same way the rest of the app does — the surface is the app's own
         dark page (#0A0A0C = the JS theme's background.primary) and the
         mark takes the dark brand ink.

         It used to force the parchment here ("the splash is always
         on-brand parchment regardless of system theme"), so a
         dark-mode launch came up on a LIGHT screen: a white flash
         before the app. The parchment is the LIGHT theme's surface,
         not the brand's surface in general. -->
    <color name="splash_background">#0A0A0C</color>
    <color name="splash_navbar">#0A0A0C</color>

    <!-- The dark brand ink — the JS theme's `accent.brandInk`
         (src/theme/tokens.ts). #B27340 on #0A0A0C = 5.1:1, under the
         gold wordmark's 8.7:1 so the name stays the hero. The old
         #5C3A1E on this page measured 1.96:1 — drawn, and invisible. -->
    <color name="splash_ink">#B27340</color>

    <!-- The dark theme's gold — the JS theme's `accent.gold`. -->
    <color name="splash_wordmark">#C9A84C</color>
</resources>
