<?xml version="1.0" encoding="utf-8"?>
<!--
  v7 native splash layout — parchment background with the brown
  lion logo, gold glow, gold indeterminate loading ring, and
  "Simba" subtitle in SIMBA gold.

  This is the SplashActivity layout (the rich animation path
  the user sees on cold start). For Android 12+ the system
  ALSO draws its own static splash from the @style/SplashTheme
  windowSplashScreen* attributes, so the visual brand is
  consistent across API levels.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F0E8">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Logo area: glow + lion + ring stacked -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <!-- Soft gold radial glow behind the logo (animated alpha) -->
            <ImageView
                android:id="@+id/splash_glow"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:src="@drawable/splash_glow_radial"
                android:alpha="0.4" />

            <!-- Brown lion logo — starts scaled down, animated in activity -->
            <ImageView
                android:id="@+id/splash_logo"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_splash_logo"
                android:scaleType="centerInside"
                android:alpha="0"
                android:scaleX="0.85"
                android:scaleY="0.85" />

            <!-- SIMBA-gold indeterminate loading ring around the logo -->
            <ImageView
                android:id="@+id/splash_loading_ring"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:src="@drawable/splash_loading_ring"
                android:alpha="0" />
        </FrameLayout>

        <!-- Wordmark — v7 title case "Simba" in SIMBA gold. -->
        <TextView
            android:id="@+id/splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Simba"
            android:textColor="#B8922E"
            android:textSize="14sp"
            android:alpha="0"
            android:letterSpacing="0.15"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</FrameLayout>
