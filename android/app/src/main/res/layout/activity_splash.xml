<?xml version="1.0" encoding="utf-8"?>
<!--
  v7 native splash layout — the page surface with the lion logo, gold
  glow, the brand-ink loading ring, and the "Simba" wordmark in gold.

  The surface and the mark follow the PHONE's night mode through
  @color/splash_background and @color/splash_ink (qualified in
  values/ and values-night/), so the native splash and the JS splash
  after it are the same picture in both themes.

  This is the SplashActivity layout (the rich animation path
  the user sees on cold start). For Android 12+ the system
  ALSO draws its own static splash from the @style/SplashTheme
  windowSplashScreen* attributes, so the visual brand is
  consistent across API levels.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_background">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Logo area: glow + lion + ring stacked -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <!-- Soft gold radial glow behind the logo (animated alpha) -->
            <ImageView
                android:id="@+id/splash_glow"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center"
                android:src="@drawable/splash_glow_radial"
                android:alpha="0.4" />

            <!-- Lion logo — the brand ink, qualified for night -->
            <ImageView
                android:id="@+id/splash_logo"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_splash_logo"
                android:scaleType="centerInside"
                android:alpha="0"
                android:scaleX="0.85"
                android:scaleY="0.85" />

            <!-- SIMBA-gold indeterminate loading ring around the logo -->
            <ImageView
                android:id="@+id/splash_loading_ring"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:src="@drawable/splash_loading_ring"
                android:alpha="0" />
        </FrameLayout>

        <!-- Wordmark — v7 title case "Simba" in SIMBA gold. -->
        <TextView
            android:id="@+id/splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Simba"
            android:textColor="@color/splash_wordmark"
            android:textSize="14sp"
            android:alpha="0"
            android:letterSpacing="0.15"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</FrameLayout>
